<?xml version="1.0" encoding="utf-8"?>
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MainWindow"
        Title="E-Health: Jadwal Imunisasi Anak" Height="650" Width="1000"
        WindowStartupLocation="CenterScreen">

    <!-- ScrollViewer untuk scroll seluruh konten -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Background="#2196F3" Padding="15" CornerRadius="5" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="E-HEALTH: SISTEM JADWAL IMUNISASI ANAK" 
                              FontSize="24" FontWeight="Bold" Foreground="White" 
                              HorizontalAlignment="Center"/>
                    <TextBlock Text="Kelola jadwal imunisasi anak Anda dengan mudah" 
                              FontSize="14" Foreground="White" 
                              HorizontalAlignment="Center" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>

            <!-- Form Input -->
            <Border Grid.Row="1" BorderBrush="#CCCCCC" BorderThickness="1" 
                    Padding="20" CornerRadius="5" Background="#F5F5F5">
                <StackPanel>
                    <TextBlock Text="DATA ANAK DAN JADWAL IMUNISASI" 
                              FontSize="16" FontWeight="Bold" Margin="0,0,0,15"/>

                    <!-- ID Jadwal (Hidden - untuk edit) -->
                    <TextBox x:Name="txtIdJadwal" Visibility="Collapsed"/>

                    <!-- Nama Anak -->
                    <TextBlock Text="Nama Anak:" Margin="0,0,0,5"/>
                    <TextBox x:Name="txtNamaAnak" Padding="8" Margin="0,0,0,10"/>

                    <!-- Tanggal Lahir -->
                    <TextBlock Text="Tanggal Lahir:" Margin="0,0,0,5"/>
                    <DatePicker x:Name="dpTanggalLahir" Padding="8" Margin="0,0,0,10"/>

                    <!-- Jenis Imunisasi -->
                    <TextBlock Text="Jenis Imunisasi:" Margin="0,0,0,5"/>
                    <ComboBox x:Name="cmbJenisImunisasi" Padding="8" Margin="0,0,0,10">
                        <ComboBoxItem Content="BCG (0-2 bulan)"/>
                        <ComboBoxItem Content="Hepatitis B (0-7 hari)"/>
                        <ComboBoxItem Content="Polio (1-4 bulan)"/>
                        <ComboBoxItem Content="DPT (2-6 bulan)"/>
                        <ComboBoxItem Content="Campak (9 bulan)"/>
                    </ComboBox>

                    <!-- Jadwal Imunisasi -->
                    <TextBlock Text="Jadwal Imunisasi:" Margin="0,0,0,5"/>
                    <DatePicker x:Name="dpJadwalImunisasi" Padding="8" Margin="0,0,0,10"/>

                    <!-- Status -->
                    <TextBlock Text="Status:" Margin="0,0,0,5"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                        <RadioButton x:Name="rbTerjadwal" Content="Terjadwal" 
                                   GroupName="Status" Margin="0,0,20,0" IsChecked="True"/>
                        <RadioButton x:Name="rbSelesai" Content="Selesai" 
                                   GroupName="Status"/>
                    </StackPanel>

                    <!-- Mode Indicator (Edit/Add) -->
                    <TextBlock x:Name="txtModeIndicator" Text="" FontSize="12" 
                              Foreground="#FF9800" FontWeight="Bold" 
                              Margin="0,0,0,10" Visibility="Collapsed"/>

                    <!-- Tombol Aksi -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button x:Name="btnTambah" Content="Tambah Jadwal" 
                               Width="120" Padding="10" Margin="5" 
                               Background="#4CAF50" Foreground="White" 
                               FontWeight="Bold" BorderThickness="0"/>
                        <Button x:Name="btnUpdate" Content="Update Jadwal" 
                               Width="120" Padding="10" Margin="5" 
                               Background="#FF9800" Foreground="White" 
                               FontWeight="Bold" BorderThickness="0" 
                               Visibility="Collapsed"/>
                        <Button x:Name="btnBatal" Content="Batal Edit" 
                               Width="120" Padding="10" Margin="5" 
                               Background="#9E9E9E" Foreground="White" 
                               FontWeight="Bold" BorderThickness="0" 
                               Visibility="Collapsed"/>
                        <Button x:Name="btnSimpanFile" Content="Simpan ke File" 
                               Width="120" Padding="10" Margin="5" 
                               Background="#2196F3" Foreground="White" 
                               FontWeight="Bold" BorderThickness="0"/>
                        <Button x:Name="btnBersihkan" Content="Bersihkan" 
                               Width="120" Padding="10" Margin="5" 
                               Background="#607D8B" Foreground="White" 
                               FontWeight="Bold" BorderThickness="0"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Daftar Jadwal dengan ScrollViewer -->
            <Border Grid.Row="2" BorderBrush="#CCCCCC" BorderThickness="1" 
                    Padding="20" CornerRadius="5" Margin="0,20,0,0">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="DAFTAR JADWAL IMUNISASI" 
                                  FontSize="16" FontWeight="Bold" Margin="0,0,0,15"
                                  HorizontalAlignment="Left"/>
                        <TextBlock x:Name="txtJumlahData" Text="Total: 0 jadwal" 
                                  FontSize="12" Foreground="#666666" 
                                  HorizontalAlignment="Right" Margin="0,5,0,15"/>
                    </Grid>

                    <!-- ScrollViewer untuk ListView -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Height="280">
                        <ListView x:Name="lvJadwal">
                            <ListView.View>
                                <GridView>
                                    <!-- Nama Anak - Left Align -->
                                    <GridViewColumn Header="Nama Anak" Width="150">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding NamaAnak}" 
                                                          TextAlignment="Left"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>

                                    <!-- Tanggal Lahir - Center -->
                                    <GridViewColumn Header="Tanggal Lahir" Width="120">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding TanggalLahir}" 
                                                          TextAlignment="Center"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>

                                    <!-- Jenis Imunisasi - Center -->
                                    <GridViewColumn Header="Jenis Imunisasi" Width="160">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding JenisImunisasi}" 
                                                          TextAlignment="Center"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>

                                    <!-- Jadwal - Center -->
                                    <GridViewColumn Header="Jadwal" Width="120">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding JadwalImunisasi}" 
                                                          TextAlignment="Center"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>

                                    <!-- Status - Center -->
                                    <GridViewColumn Header="Status" Width="100">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Status}" 
                                                          TextAlignment="Center"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>

                                    <!-- Aksi - Center -->
                                    <GridViewColumn Header="Aksi" Width="170">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" 
                                                           HorizontalAlignment="Center">
                                                    <Button Content="Edit" Width="70" Padding="5,2" 
                                                           Margin="2" Background="#2196F3" 
                                                           Foreground="White" BorderThickness="0"
                                                           Tag="{Binding Id}"
                                                           Click="btnEdit_Click"/>
                                                    <Button Content="Hapus" Width="70" Padding="5,2" 
                                                           Margin="2" Background="#F44336" 
                                                           Foreground="White" BorderThickness="0"
                                                           Tag="{Binding Id}"
                                                           Click="btnHapus_Click"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </ScrollViewer>

                    <!-- Tips -->
                    <TextBlock Text="💡 Tips: Double-click pada baris untuk edit cepat, atau gunakan tombol Edit/Hapus" 
                              FontSize="11" Foreground="#666666" Margin="0,10,0,0" 
                              FontStyle="Italic"/>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Window>